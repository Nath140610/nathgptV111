# Copiez les valeurs dans les variables d'environnement (Render > Environment, ou PowerShell en local).
# Ne mettez jamais de vraies valeurs dans ce fichier.

# API NathGPT (Selenium). En local : http://127.0.0.1:18765 ; sur Render : une URL HTTPS publique.
NATHGPT_API_URL=https://votre-api-nathgpt.exemple
NATHGPT_API_TOKEN=collez_votre_token_ici

# Supabase (facultatif en local : sans ces deux variables, le site utilise data/nathgpt.sqlite3).
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
